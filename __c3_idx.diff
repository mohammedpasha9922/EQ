+        background: transparent;
+        color: #000000;
+        caret-color: #000000;
+        outline: none;
+        user-select: text;
+        -webkit-user-select: text;
+      }
+      @media (max-width: 480px) {
+        #smartPdfWorkspace .smart-pdf-viewer-scroll {
+          padding: 10px 6px 20px;
+        }
+      }
